--!strict
local T = require("./TestHarness")
local Shop = require("../src/shared/ShopRules")
local Definitions = require("../src/shared/MagnetDefinitions")
local function state(coins: number): any
	return { coins = coins, magnetTier = 1, ownedMagnets = { starter = true }, upgrades = { range = 2, power = 3, speed = 4 }, inventory = { gear = 3 } }
end
T.test("cosmetic catalog has identity and no stat grant", function()
	for _, definition in Definitions do
		T.equal(Shop.definitionFor(Definitions, definition.tier), definition)
		T.equal((definition :: any).radius, nil)
	end
end)
T.test("any unowned appearance can be purchased without sequential gating", function()
	local s = state(100)
	T.equal(Shop.purchase(s, Definitions, 3), "purchased")
	T.equal(s.coins, 0)
	T.equal(s.magnetTier, 3)
	T.equal(s.ownedMagnets.gold, true)
	T.equal(s.ownedMagnets.iron, nil)
	T.equal(s.upgrades.range, 2)
	T.equal(s.upgrades.power, 3)
	T.equal(s.upgrades.speed, 4)
	T.equal(s.inventory.gear, 3)
end)
T.test("owned appearances equip free and replay never charges", function()
	local s = state(25)
	T.equal(Shop.purchase(s, Definitions, 2), "purchased")
	T.equal(Shop.purchase(s, Definitions, 2), "owned")
	T.equal(Shop.purchase(s, Definitions, 1), "equipped")
	T.equal(Shop.purchase(s, Definitions, 2), "equipped")
	T.equal(s.coins, 0)
	T.equal(s.ownedMagnets.starter, true)
	T.equal(s.ownedMagnets.iron, true)
end)
T.test("unaffordable cosmetic cannot debit equip or grant ownership", function()
	local s = state(99)
	T.equal(Shop.purchase(s, Definitions, 3), "insufficientCoins")
	T.equal(s.coins, 99)
	T.equal(s.magnetTier, 1)
	T.equal(s.ownedMagnets.gold, nil)
end)
for _, value in { 0, -1, 1.5, 4, math.huge, 0/0, "2", true, {} } do
	T.test("invalid cosmetic request " .. tostring(value) .. " cannot mutate", function()
		local s = state(100)
		T.equal(Shop.purchase(s, Definitions, value), "invalidTier")
		T.equal(s.coins, 100)
		T.equal(s.magnetTier, 1)
	end)
end
T.test("missing cosmetic request cannot mutate", function()
	local s = state(100)
	T.equal(Shop.purchase(s, Definitions, nil), "invalidTier")
	T.equal(s.coins, 100)
end)
for _, value in { -1, 1.5, math.huge, 0/0, 9007199254740992, "25", true } do
	T.test("invalid wallet rejects cosmetic transaction " .. tostring(value), function()
		local s = state(100)
		s.coins = value
		T.equal(Shop.purchase(s, Definitions, 2), nil)
		T.equal(s.magnetTier, 1)
		T.equal(s.ownedMagnets.iron, nil)
	end)
end
T.test("equipped unowned appearance is invalid server state", function()
	local s = state(100)
	s.magnetTier = 2
	T.equal(Shop.purchase(s, Definitions, 3), nil)
	T.equal(s.coins, 100)
end)
T.test("duplicate cosmetic tier cannot resolve or charge", function()
	local catalog = table.clone(Definitions)
	catalog[3] = table.clone(Definitions[2])
	T.equal(Shop.definitionFor(catalog, 2), nil)
	local s = state(100)
	T.equal(Shop.purchase(s, catalog, 2), nil)
	T.equal(s.coins, 100)
end)
return true
